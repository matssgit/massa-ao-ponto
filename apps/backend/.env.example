# Production requires sslmode=verify-full and a trusted CA from the runtime environment.
DATABASE_URL=postgresql://user:password@localhost:5432/massa_ao_ponto
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_READINESS_TIMEOUT_MS=3000
NODE_ENV=development
PORT=3333
TRUST_PROXY_HOPS=0
LOG_LEVEL=debug
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_MEMBER_INVITATION_TTL_SECONDS=604800
PUBLIC_AVAILABILITY_RATE_LIMIT_MAX=120
PUBLIC_AVAILABILITY_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RESERVATION_CREATE_RATE_LIMIT_MAX=10
PUBLIC_RESERVATION_CREATE_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_RESERVATION_ACCESS_RATE_LIMIT_MAX=60
PUBLIC_RESERVATION_ACCESS_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_ORDER_CREATE_RATE_LIMIT_MAX=10
PUBLIC_ORDER_CREATE_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_ORDER_LOOKUP_RATE_LIMIT_MAX=120
PUBLIC_ORDER_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_ORDER_CANCEL_RATE_LIMIT_MAX=30
PUBLIC_ORDER_CANCEL_RATE_LIMIT_WINDOW_SECONDS=300
